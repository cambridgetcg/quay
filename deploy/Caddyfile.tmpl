# Quay production Caddyfile — automatic TLS, on-demand for deploy subdomains.
# install.sh renders this with `envsubst`, so tokens are bare ${VAR} (NOT Caddy's
# {$VAR} brace form, which envsubst would leave malformed).

{
	email ${QUAY_ACME_EMAIL}
	on_demand_tls {
		# Mint a cert only if the daemon confirms the host maps to a real project,
		# so random *.quay.<domain> probes can't exhaust Let's Encrypt rate limits.
		ask http://127.0.0.1:7000/internal/tls-check
	}
}

# Admin dashboard + JSON API
quay.${QUAY_DOMAIN} {
	# /internal/* is loopback-only in the daemon, but block it at the edge too.
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:7000
	encode zstd gzip
}

# Every deploy: <project>.quay.<domain> and <version>--<project>.quay.<domain>
*.quay.${QUAY_DOMAIN} {
	tls {
		on_demand
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:7000
	encode zstd gzip
}
